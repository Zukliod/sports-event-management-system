datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum EventStatus {
  Draft
  Registration_Open
  Ongoing
  Completed
  Archived
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  passwordHash    String           @map("password_hash")
  photoUrl        String?          @map("photo_url")
  phone           String?
  institute       String           // Updated to match finalized ERD
  createdAt       DateTime         @default(now()) @map("created_at")
  
  // Relations
  createdEvents   Event[]          @relation("EventCreator")
  roleAssignments RoleAssignment[]
  captainedTeams  Team[]           @relation("TeamCaptain")
  teams           TeamMember[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Event {
  id              Int              @id @default(autoincrement())
  title           String
  status          EventStatus      @default(Draft)
  startDate       DateTime         @map("start_date")
  endDate         DateTime         @map("end_date")
  venue           String
  createdBy       Int              @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at")

  // Relations
  creator         User             @relation("EventCreator", fields: [createdBy], references: [id])
  roleAssignments RoleAssignment[]
  teams           Team[]
  matches         Match[]

  @@map("events")
}

model RoleAssignment {
  userId  Int @map("user_id")
  eventId Int @map("event_id")
  roleId  Int @map("role_id") // 1: Super Admin, 2: Event Admin, 3: Sport Coordinator

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId, roleId])
  @@map("role_assignments")
}

model Sport {
  id           Int     @id @default(autoincrement())
  name         String
  rules        String?
  scoringModel Json    @map("scoring_model") // Dynamic JSON Schema for sports scoring

  // Relations
  matches      Match[]

  @@map("sports")
}

model Team {
  id          Int          @id @default(autoincrement())
  teamName    String       @map("team_name")
  captainId   Int          @map("captain_id")
  eventId     Int          @map("event_id")
  
  // Relations
  captain     User         @relation("TeamCaptain", fields: [captainId], references: [id])
  event       Event        @relation(fields: [eventId], references: [id])
  members     TeamMember[]
  matches     MatchTeam[]
  payments    Payment[]

  @@map("teams")
}

model TeamMember {
  teamId Int @map("team_id")
  userId Int @map("user_id")

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Match {
  id           Int         @id @default(autoincrement())
  sportId      Int         @map("sport_id")
  eventId      Int         @map("event_id")
  scheduleTime DateTime    @map("schedule_time")
  status       String      @default("Scheduled")
  result       Json?       // Dynamic final scores / stats
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  sport        Sport       @relation(fields: [sportId], references: [id])
  event        Event       @relation(fields: [eventId], references: [id])
  teams        MatchTeam[]

  @@map("matches")
}

model MatchTeam {
  matchId Int @map("match_id")
  teamId  Int @map("team_id")

  // Relations
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([matchId, teamId])
  @@map("match_teams")
}

model Payment {
  id            Int      @id @default(autoincrement())
  teamId        Int      @map("team_id") // Tied directly to Team instance
  amount        Float
  transactionId String   @map("transaction_id")
  status        String

  // Relations
  team          Team     @relation(fields: [teamId], references: [id])

  @@map("payments")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  timestamp DateTime @default(now())
  ipAddress String   @map("ip_address")

  // Relations
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}